<script>
gsap.registerPlugin(ScrollTrigger);

// Progress
gsap.to('.progress',{width:'100%',ease:'none',scrollTrigger:{trigger:'body',start:'top top',end:'bottom bottom',scrub:.3}});

// Nav
ScrollTrigger.create({start:'top -80',onUpdate:s=>{document.querySelector('.nav').classList.toggle('scrolled',s.progress>0)}});

// Hero
const tl=gsap.timeline({delay:.3});
tl.fromTo('.hero__logo',{opacity:0,y:60},{opacity:1,y:0,duration:1.2,ease:'power2.out'})
.fromTo('.hero__tagline',{opacity:0},{opacity:1,duration:.8,ease:'power2.out'},'-=.5')
.fromTo('.hero__text',{opacity:0,y:20},{opacity:1,y:0,duration:.8,ease:'power2.out'},'-=.3')
.fromTo('.hero__btn',{opacity:0,y:15},{opacity:1,y:0,duration:.6,ease:'power2.out'},'-=.2')
.to('.hero__scroll',{opacity:1,duration:.5},'-=.1');

// Scroll animations
gsap.utils.toArray('.brand__accent,.st,.ey,.section-text,.brand__text,.about__header,.community__header,.services__header,.events__header,.testimonials__header,.benefits__header,.podcast__inner,.mv-card').forEach(el=>{
  gsap.fromTo(el,{opacity:0,y:25},{opacity:1,y:0,duration:.7,scrollTrigger:{trigger:el,start:'top 85%'}});
});

// Cards
gsap.utils.toArray('.founder,.comm-card,.service,.event,.testimonial,.benefit,.community-photos__item').forEach((el,i)=>{
  gsap.fromTo(el,{opacity:0,y:35},{opacity:1,y:0,duration:.6,delay:(i%4)*.08,scrollTrigger:{trigger:el,start:'top 88%'}});
});

// Mobile menu
const hb=document.querySelector('.hamburger'),mm=document.querySelector('.mob-menu');
hb.addEventListener('click',()=>{hb.classList.toggle('active');mm.classList.toggle('active');document.body.style.overflow=mm.classList.contains('active')?'hidden':''});
mm.querySelectorAll('a').forEach(a=>{a.addEventListener('click',()=>{hb.classList.remove('active');mm.classList.remove('active');document.body.style.overflow=''})});

// Smooth scroll
document.querySelectorAll('a[href^="#"]').forEach(a=>{a.addEventListener('click',e=>{e.preventDefault();const t=document.querySelector(a.getAttribute('href'));if(t)t.scrollIntoView({behavior:'smooth'})})});
</script>
